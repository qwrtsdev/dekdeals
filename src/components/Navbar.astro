---
import Logo from "@/assets/fire.png";
import { Heart, Moon, Search, Sun, X } from "@lucide/astro";
import { getCollection } from "astro:content";

// slug -> what the saved-deals drawer shows for it
const dealInfo = Object.fromEntries(
	(await getCollection("offers")).map(({ id, data }) => [
		id,
		{ name: data.name, provider: data.provider, icon: data.icon },
	]),
);
---

<nav>
	<div
		data-navbar
		class="mx-auto max-w-full border-b border-slate-200 bg-white shadow-black/20 transition-[max-width,translate,border-radius,box-shadow] duration-500 ease-[linear(0.0,0.087,0.288,0.523,0.743,0.917,1.036,1.102,1.126,1.12,1.097,1.067,1.038,1.015,0.998,0.988,0.984,0.984,0.987,0.991,0.994,0.997,1.0,1.001,1.002,1)] motion-reduce:transition-none data-scrolled:shadow-sm data-scrolled:max-w-[min(69rem,calc(100%_-_3rem))] data-scrolled:translate-y-3 data-scrolled:rounded-2xl data-scrolled:border md:data-scrolled:translate-y-6"
	>
		<div
			class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6 md:gap-6"
		>
			<a
				href="/"
				class="flex shrink-0 items-center gap-2 transition-transform duration-150 hover:scale-105"
				aria-label="DekDeals home"
			>
				<img src={Logo.src} alt="" class="size-8 object-contain" />
				<span class="font-noto-sans-thai text-xl font-black text-brand"
					>DEKD(EALS)</span
				>
			</a>

			<div class="flex shrink-0 items-center gap-1">
				<form
					action="/deals"
					method="get"
					role="search"
					class="hidden min-w-0 flex-1 justify-center sm:flex"
				>
					<label for="navbar-search" class="sr-only"
						>ค้นหาดีลเด็ด..</label
					>
					<div class="relative w-full max-w-md">
						<Search
							size={18}
							stroke-width={2}
							class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
						/>
						<input
							id="navbar-search"
							name="q"
							type="search"
							placeholder="ค้นหาดีล..."
							data-navbar-search
							class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-10 pr-10 text-sm text-slate-950 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-orange-400 focus:bg-white focus:ring-2 focus:ring-orange-400/20 [&::-webkit-search-cancel-button]:hidden"
						/>
						<button
							type="button"
							data-navbar-search-clear
							class="absolute right-2 top-1/2 hidden -translate-y-1/2 rounded-md p-1 text-slate-400"
							aria-label="ล้างคำค้นหา"
						>
							<X size={16} stroke-width={2} />
						</button>
					</div>
				</form>
				<button
					type="button"
					data-mobile-search-trigger
					aria-controls="mobile-search-drawer"
					aria-expanded="false"
					class="rounded-xl p-2.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-950 focus-visible:outline-2 focus-visible:outline-orange-400 sm:hidden"
					aria-label="เปิดค้นหา"
				>
					<Search size={20} stroke-width={2} />
				</button>
				<button
					type="button"
					data-favorites-trigger
					aria-controls="favorites-drawer"
					aria-expanded="false"
					class="relative rounded-xl p-2.5 text-pink-500 transition hover:bg-pink-500/10 hover:text-pink-600 focus-visible:outline-2 focus-visible:outline-pink-500"
					aria-label="ดีลที่บันทึกไว้"
				>
					<Heart size={20} stroke-width={2} />
					<span
						data-fav-badge
						hidden
						class="absolute right-0.5 top-0.5 grid min-w-4 place-items-center rounded-full bg-pink-500 px-1 text-[10px] font-bold leading-4 text-white"
					></span>
				</button>
				<button
					type="button"
					data-theme-toggle
					class="rounded-xl p-2.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-950 focus-visible:outline-2 focus-visible:outline-orange-400"
					aria-label="สลับโหมดสว่าง/มืด"
				>
					<Moon size={20} stroke-width={2} class="dark:hidden" />
					<Sun size={20} stroke-width={2} class="hidden dark:block" />
				</button>
			</div>
		</div>
	</div>
</nav>

<div
	id="mobile-search-drawer"
	data-mobile-search-drawer
	role="dialog"
	aria-modal="true"
	aria-hidden="true"
	class="pointer-events-none fixed inset-x-0 top-0 z-50 -translate-y-full border-b border-slate-200 bg-white p-4 text-left opacity-0 shadow-2xl transition-all duration-300 ease-out"
	aria-labelledby="mobile-search-title"
>
	<div class="flex items-center gap-3">
		<h2 id="mobile-search-title" class="sr-only">ค้นหาดีล</h2>
		<form action="/deals" method="get" role="search" class="min-w-0 flex-1">
			<label for="mobile-navbar-search" class="sr-only">ค้นหาดีล</label>
			<div class="relative">
				<Search
					size={18}
					stroke-width={2}
					class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
				/>
				<input
					id="mobile-navbar-search"
					name="q"
					type="search"
					placeholder="ค้นหาดีล..."
					data-navbar-search
					class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-10 pr-10 text-sm text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-orange-400 focus:bg-white focus:ring-2 focus:ring-orange-400/20 [&::-webkit-search-cancel-button]:hidden"
				/>
				<button
					type="button"
					data-navbar-search-clear
					class="absolute right-2 top-1/2 hidden -translate-y-1/2 rounded-md p-1 text-slate-400"
					aria-label="ล้างคำค้นหา"
				>
					<X size={16} stroke-width={2} />
				</button>
			</div>
		</form>
		<button
			type="button"
			data-mobile-search-close
			class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-950"
			aria-label="ปิดค้นหา"
		>
			<X size={20} stroke-width={2} />
		</button>
	</div>
</div>
<div
	data-mobile-search-backdrop
	class="pointer-events-none fixed inset-0 z-40 bg-black/50 opacity-0 transition-opacity duration-300"
	aria-hidden="true"
>
</div>

<dialog
	id="favorites-drawer"
	data-favorites-drawer
	class="fixed inset-y-0 right-0 m-0 ml-auto flex h-full max-h-none w-full max-w-sm translate-x-full flex-col bg-white p-0 text-left shadow-2xl transition-transform duration-300 ease-out backdrop:bg-black/50 md:max-w-xl [&:not([open])]:hidden"
	aria-labelledby="favorites-title"
>
	<div
		class="flex items-center justify-between border-b border-slate-200 px-6 py-5"
	>
		<h2 id="favorites-title" class="text-lg font-semibold text-slate-950">
			ดีลที่บันทึกไว้
		</h2>
		<button
			type="button"
			data-favorites-close
			class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-950"
			aria-label="ปิด"
		>
			<X size={20} stroke-width={2} />
		</button>
	</div>
	<div class="flex-1 space-y-8 overflow-y-auto px-6 py-6">
		{
			[
				[
					"favorites",
					"รายการโปรด",
					"ยังไม่มีดีลที่ชอบเลย ลองหาสิ่งที่ชอบดูนะ!",
				],
				[
					"done",
					"ที่ใช้สิทธิ์แล้ว",
					"ยังไม่มีดีลที่ใช้สิทธิ์แล้ว รีบใช้ก่อนไม่ทัน!",
				],
			].map(([kind, title, empty]) => (
				<section>
					<h3 class="flex items-center gap-2 text-sm font-semibold text-slate-950">
						{title}
						<span
							data-saved-count={kind}
							class="rounded-full bg-slate-100 px-2 text-xs font-medium text-slate-600"
						/>
					</h3>
					<ul
						data-saved-list={kind}
						class="mt-3 divide-y divide-slate-100"
					/>
					<p
						data-saved-empty={kind}
						class="mt-3 text-sm text-slate-500"
					>
						{empty}
					</p>
				</section>
			))
		}
	</div>
	<template data-saved-item>
		<li class="flex items-center gap-2">
			<a
				class="flex min-w-0 flex-1 items-center gap-3 rounded-lg py-2.5 transition hover:bg-slate-50"
			>
				<span
					data-initial
					class="grid size-9 shrink-0 place-items-center rounded-lg bg-orange-400 text-sm font-black text-white"
				></span>
				<span class="min-w-0">
					<span data-provider class="block text-xs text-slate-500"
					></span>
					<span
						data-name
						class="block truncate font-semibold text-slate-950"
					></span>
				</span>
			</a>
			<button
				type="button"
				data-remove
				class="shrink-0 rounded-lg p-2 text-slate-400 focus-visible:outline-2 focus-visible:outline-orange-400"
			>
				<X size={18} stroke-width={2} />
			</button>
		</li>
	</template>
	<script
		type="application/json"
		id="saved-deals"
		set:html={JSON.stringify(dealInfo).replace(/</g, "\\u003c")}
	/>
</dialog>

<script>
	import {
		getSaved,
		onSavedChange,
		toggleSaved,
		type SavedKind,
	} from "@/lib/saved";

	// Saved deals drawer + heart badge
	const dealInfo: Record<
		string,
		{ name: string; provider: string; icon?: string }
	> =
		JSON.parse(document.getElementById("saved-deals")!.textContent!);
	const itemTemplate =
		document.querySelector<HTMLTemplateElement>("[data-saved-item]")!;
	const favBadge = document.querySelector<HTMLElement>("[data-fav-badge]")!;

	function renderSaved() {
		for (const kind of ["favorites", "done"] as SavedKind[]) {
			// skip slugs of deals that no longer exist
			const ids = getSaved(kind).filter((id) => id in dealInfo);
			const items = ids.map((id) => {
				const li = itemTemplate.content.firstElementChild!.cloneNode(
					true,
				) as HTMLLIElement;
				li.querySelector("a")!.href = `/deals/${id}`;
				const initial = li.querySelector<HTMLElement>("[data-initial]")!;
				if (dealInfo[id].icon) {
					const img = document.createElement("img");
					img.src = dealInfo[id].icon!;
					img.alt = "";
					img.referrerPolicy = "no-referrer";
					img.className = "size-full object-contain";
					initial.classList.replace("bg-orange-400", "bg-white");
					initial.classList.add("overflow-hidden");
					initial.append(img);
				} else {
					initial.textContent = dealInfo[id].provider[0];
				}
				li.querySelector("[data-provider]")!.textContent =
					dealInfo[id].provider;
				li.querySelector("[data-name]")!.textContent =
					dealInfo[id].name;
				const remove =
					li.querySelector<HTMLButtonElement>("[data-remove]")!;
				remove.setAttribute(
					"aria-label",
					`เอา ${dealInfo[id].name} ออก`,
				);
				remove.addEventListener("click", () => toggleSaved(kind, id));
				return li;
			});
			document
				.querySelector(`[data-saved-list="${kind}"]`)!
				.replaceChildren(...items);
			document.querySelector<HTMLElement>(
				`[data-saved-empty="${kind}"]`,
			)!.hidden = ids.length > 0;
			document.querySelector(
				`[data-saved-count="${kind}"]`,
			)!.textContent = String(ids.length);
			if (kind === "favorites") {
				favBadge.hidden = ids.length === 0;
				favBadge.textContent = String(ids.length);
			}
		}
	}
	renderSaved();
	onSavedChange(renderSaved);

	const navbar = document.querySelector<HTMLElement>("[data-navbar]");
	const updateNavbar = () =>
		navbar?.toggleAttribute("data-scrolled", window.scrollY > 8);
	updateNavbar();
	window.addEventListener("scroll", updateNavbar, { passive: true });

	document
		.querySelector("[data-theme-toggle]")
		?.addEventListener("click", () => {
			const dark = document.documentElement.classList.toggle("dark");
			try {
				localStorage.setItem("theme", dark ? "dark" : "light");
			} catch {}
		});

	const trigger = document.querySelector<HTMLButtonElement>(
		"[data-favorites-trigger]",
	);
	const drawer = document.querySelector<HTMLDialogElement>(
		"[data-favorites-drawer]",
	);
	const closeButton = document.querySelector<HTMLButtonElement>(
		"[data-favorites-close]",
	);
	// each X clears the input that sits in the same wrapper as it
	document
		.querySelectorAll<HTMLButtonElement>("[data-navbar-search-clear]")
		.forEach((searchClearButton) => {
			const searchInput =
				searchClearButton.parentElement?.querySelector<HTMLInputElement>(
					"[data-navbar-search]",
				);
			if (!searchInput) return;

			const updateSearchClearButton = () => {
				searchClearButton.classList.toggle(
					"hidden",
					searchInput.value.length === 0,
				);
			};

			searchInput.addEventListener("input", updateSearchClearButton);
			searchClearButton.addEventListener("click", () => {
				searchInput.value = "";
				updateSearchClearButton();
				searchInput.focus();
			});
		});

	const mobileSearchTrigger = document.querySelector<HTMLButtonElement>(
		"[data-mobile-search-trigger]",
	);
	const mobileSearchDrawer = document.querySelector<HTMLDivElement>(
		"[data-mobile-search-drawer]",
	);
	const mobileSearchBackdrop = document.querySelector<HTMLDivElement>(
		"[data-mobile-search-backdrop]",
	);
	const mobileSearchClose = document.querySelector<HTMLButtonElement>(
		"[data-mobile-search-close]",
	);

	if (
		mobileSearchTrigger &&
		mobileSearchDrawer &&
		mobileSearchBackdrop &&
		mobileSearchClose
	) {
		let mobileSearchCloseTimeout: number | undefined;

		const closeMobileSearch = () => {
			mobileSearchDrawer.classList.remove("translate-y-0");
			mobileSearchDrawer.classList.add("-translate-y-full");
			mobileSearchDrawer.classList.remove(
				"opacity-100",
				"pointer-events-auto",
			);
			mobileSearchDrawer.classList.add(
				"opacity-0",
				"pointer-events-none",
			);
			mobileSearchBackdrop.classList.remove(
				"opacity-100",
				"pointer-events-auto",
			);
			mobileSearchBackdrop.classList.add(
				"opacity-0",
				"pointer-events-none",
			);
			mobileSearchDrawer.setAttribute("aria-hidden", "true");
			mobileSearchTrigger.setAttribute("aria-expanded", "false");
			document.body.classList.remove("overflow-hidden");
			mobileSearchCloseTimeout = window.setTimeout(() => {
				mobileSearchDrawer.style.visibility = "hidden";
			}, 300);
			mobileSearchTrigger.focus();
		};

		mobileSearchTrigger.addEventListener("click", () => {
			window.clearTimeout(mobileSearchCloseTimeout);
			mobileSearchDrawer.style.visibility = "visible";
			mobileSearchTrigger.setAttribute("aria-expanded", "true");
			mobileSearchDrawer.setAttribute("aria-hidden", "false");
			mobileSearchDrawer.classList.remove(
				"-translate-y-full",
				"opacity-0",
				"pointer-events-none",
			);
			mobileSearchDrawer.classList.add(
				"translate-y-0",
				"opacity-100",
				"pointer-events-auto",
			);
			mobileSearchBackdrop.classList.remove(
				"opacity-0",
				"pointer-events-none",
			);
			mobileSearchBackdrop.classList.add(
				"opacity-100",
				"pointer-events-auto",
			);
			document.body.classList.add("overflow-hidden");
			requestAnimationFrame(() => {
				mobileSearchDrawer
					.querySelector<HTMLInputElement>("[data-navbar-search]")
					?.focus();
			});
		});
		mobileSearchClose.addEventListener("click", closeMobileSearch);
		mobileSearchBackdrop.addEventListener("click", closeMobileSearch);
		document.addEventListener("keydown", (event) => {
			if (
				event.key === "Escape" &&
				mobileSearchTrigger.getAttribute("aria-expanded") === "true"
			) {
				closeMobileSearch();
				mobileSearchTrigger.setAttribute("aria-expanded", "false");
				mobileSearchTrigger.focus();
			}
		});
	}

	if (trigger && drawer && closeButton) {
		let closeTimeout: number | undefined;

		const openDrawer = () => {
			window.clearTimeout(closeTimeout);
			drawer.showModal();
			trigger.setAttribute("aria-expanded", "true");
			requestAnimationFrame(() => {
				drawer.classList.remove("translate-x-full");
				drawer.classList.add("translate-x-0");
				closeButton.focus();
			});
		};

		const closeDrawer = () => {
			drawer.classList.remove("translate-x-0");
			drawer.classList.add("translate-x-full");
			closeTimeout = window.setTimeout(() => drawer.close(), 300);
		};

		trigger.addEventListener("click", openDrawer);
		closeButton.addEventListener("click", closeDrawer);
		drawer.addEventListener("click", (event) => {
			if (event.target === drawer) closeDrawer();
		});
		drawer.addEventListener("cancel", (event) => {
			event.preventDefault();
			closeDrawer();
		});
		drawer.addEventListener("close", () => {
			trigger.setAttribute("aria-expanded", "false");
			trigger.focus();
		});
	}
</script>
