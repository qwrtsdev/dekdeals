---
// The deal's site icon (from `npm run og`) drawn over the provider's first letter.
// If the icon is missing or fails to load, the orange letter tile shows instead.
// Pass size, rounding and text size through `class`.
interface Props {
	provider: string;
	icon?: string;
	class?: string;
}

const { provider, icon, class: className } = Astro.props;
---

<span
	aria-hidden="true"
	class:list={[
		"relative grid shrink-0 place-items-center overflow-hidden bg-orange-400 font-black text-white",
		className,
	]}
>
	{provider[0]}
	{
		icon && (
			<img
				src={icon}
				alt=""
				loading="lazy"
				referrerpolicy="no-referrer"
				onerror="this.remove()"
				class="absolute inset-0 size-full bg-white object-contain"
			/>
		)
	}
</span>
