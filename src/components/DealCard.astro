---
import type { CollectionEntry } from "astro:content";
import { categories, conditionals } from "@/lib/labels";
import DealIcon from "@/components/DealIcon.astro";
import { ArrowUpRight } from "@lucide/astro";

interface Props {
	deal: CollectionEntry<"offers">;
}

const { id, data } = Astro.props.deal;
---

<a
	href={`/deals/${id}`}
	class="group relative isolate flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface p-5 transition hover:border-orange-400/60"
>
	{
		data.image && (
			// same blurred og:image as the deal page, fading out from the top of the card
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-36 overflow-hidden [mask-image:linear-gradient(to_bottom,black_20%,transparent)]"
			>
				<img
					src={data.image}
					alt=""
					loading="lazy"
					decoding="async"
					referrerpolicy="no-referrer"
					class="size-full scale-110 object-cover opacity-50 blur-[3px] dark:opacity-40"
				/>
			</div>
		)
	}
	<div class="flex items-start justify-between gap-3">
		<DealIcon
			provider={data.provider}
			icon={data.icon}
			class="size-11 rounded-xl text-lg"
		/>
		<ArrowUpRight
			size={18}
			stroke-width={2}
			class="text-faint transition group-hover:text-orange-400"
		/>
	</div>
	<p class="mt-4 text-xs font-medium text-faint">{data.provider}</p>
	<h3 class="text-lg font-bold text-ink">{data.name}</h3>
	<p class="mt-2 line-clamp-2 flex-1 text-sm leading-6 text-muted">
		{data.summary.th}
	</p>
	<div class="mt-4 flex flex-wrap gap-1.5 text-xs">
		<span
			class="rounded-md bg-orange-400/10 px-2 py-1 font-medium text-orange-400"
		>
			{categories[data.category]}
		</span>
		<span class="rounded-md bg-subtle px-2 py-1 text-muted">
			{conditionals[data.eligibility.method]}
		</span>
	</div>
</a>
