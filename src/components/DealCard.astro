---
import type { CollectionEntry } from "astro:content";
import { categories, conditionals } from "@/lib/labels";
import DealIcon from "@/components/DealIcon.astro";
import { ArrowUpRight } from "@lucide/astro";

interface Props {
	deal: CollectionEntry<"offers">;
}

const { id, data } = Astro.props.deal;
---

<a
	href={`/deals/${id}`}
	class:list={[
		"group relative isolate flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface p-5 transition-[translate,border-color] duration-150 ease-out hover:-translate-y-1 hover:border-orange-400/70 active:translate-y-0",
		data.archived && "opacity-60 grayscale",
	]}
>
	{
		data.image && (
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-36 overflow-hidden [mask-image:linear-gradient(to_bottom,black_20%,transparent)]"
			>
				<img
					src={data.image}
					alt=""
					loading="lazy"
					decoding="async"
					referrerpolicy="no-referrer"
					class="size-full scale-110 object-cover opacity-50 blur-[3px] transition-transform duration-300 ease-out group-hover:scale-125 dark:opacity-35"
				/>
			</div>
		)
	}
	<div class="flex items-start gap-3">
		<DealIcon
			provider={data.provider}
			icon={data.icon}
			class="size-12 rounded-xl text-lg ring-1 ring-line"
		/>
		<div class="min-w-0 flex-1">
			<p class="text-xs font-medium text-faint">
				{data.provider}
				{
					data.archived && (
						<span class="ml-1 rounded bg-subtle px-1.5 py-0.5">
							สิ้นสุดแล้ว
						</span>
					)
				}
			</p>
			<h3 class="text-lg font-bold leading-snug text-ink">{data.name}</h3>
		</div>
		<ArrowUpRight
			size={18}
			stroke-width={2}
			class="shrink-0 text-faint transition duration-150 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-orange-400"
		/>
	</div>
	<p class="mt-4 line-clamp-2 flex-1 text-sm leading-6 text-muted">
		{data.summary.th}
	</p>
	<div class="mt-4 flex flex-wrap gap-1.5 text-xs">
		<span class="rounded-md bg-orange-400/15 px-2 py-1 font-medium text-orange-700 dark:text-orange-300">
			{categories[data.category]}
		</span>
		<span class="rounded-md bg-subtle px-2 py-1 text-muted">
			{conditionals[data.eligibility.method]}
		</span>
	</div>
</a>
