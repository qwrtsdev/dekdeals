---
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";
import { Font } from "astro:assets";
import Analytics from "@vercel/analytics/astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title,
	description = "แคตตาล็อครวมส่วนลดและสิทธิพิเศษสำหรับนักเรียนนักศึกษา เพื่อความคุ้มขั้นสุด",
} = Astro.props;
---

<html lang="th">
	<head>
		<meta charset="utf-8" />
		<link
			rel="icon"
			type="image/x-icon"
			href="/favicon.ico"
			sizes="96x96"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title ? `${title} - DekDeals` : "DekDeals"}</title>
		<Font cssVariable="--font-noto-sans-thai" preload />
		<Font cssVariable="--font-pixeloid" preload />
		<script is:inline>
			let theme = null;
			try {
				theme = localStorage.getItem("theme");
			} catch {}
			document.documentElement.classList.toggle(
				"dark",
				theme
					? theme === "dark"
					: matchMedia("(prefers-color-scheme: dark)").matches,
			);
		</script>
	</head>
	<body class="flex min-h-dvh flex-col bg-page text-ink antialiased">
		<Analytics />
		<div class="sticky top-0 z-50">
			<Navbar />
		</div>
		<div><slot /></div>
		<Footer />
	</body>
</html>

<script>
	if (import.meta.env.PROD && "serviceWorker" in navigator) {
		navigator.serviceWorker.register("/sw.js");
	}
</script>
