---
import Navbar from "@/components/Navbar.astro";
import ShapeGrid from "@/components/ShapeGrid.jsx";
import "@/styles/global.css";
import { Font } from "astro:assets";
import Analytics from "@vercel/analytics/astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title,
	description = "แคตตาล็อครวมส่วนลดและสิทธิพิเศษสำหรับนักเรียนนักศึกษา เพื่อความคุ้มขั้นสุด",
} = Astro.props;
---

<html lang="th">
	<head>
		<meta charset="utf-8" />
		<link
			rel="icon"
			type="image/x-icon"
			href="/favicon.ico"
			sizes="96x96"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title ? `${title} - DekDeals` : "DekDeals"}</title>
		<Font cssVariable="--font-noto-sans-thai" preload />
		<script is:inline>
			let theme = null;
			try {
				theme = localStorage.getItem("theme");
			} catch {}
			document.documentElement.classList.toggle(
				"dark",
				theme
					? theme === "dark"
					: matchMedia("(prefers-color-scheme: dark)").matches,
			);
		</script>
	</head>
	<body class="flex min-h-dvh flex-col bg-page text-ink antialiased">
		<Analytics />
		<div class="vt-navbar sticky top-0 z-50">
			<Navbar />
		</div>
		<div><slot /></div>
		<footer
			class="relative isolate flex-1 overflow-hidden border-t border-line"
		>
			<ShapeGrid
				client:visible
				className="pointer-events-none absolute! inset-x-0! -top-24! h-[calc(100%+12rem)]! z-[-1]"
				shape="square"
				cellSize={32}
				direction="diagonal"
				speed={0.3}
				lineColor="#a3a3a3"
				hoverColor="#fb923c"
				opacity={0.45}
				fade={0.6}
			/>
			<div
				class="mx-auto flex max-w-6xl flex-col items-center gap-1 px-6 py-8 text-sm text-muted sm:flex-row sm:justify-between"
			>
				<p>
					เว็บไซต์โดย <a
						href="https://qwrts.dev/"
						target="_blank"
						class="font-semibold text-ink underline decoration-orange-400 decoration-2 underline-offset-4 transition-colors hover:text-orange-400"
						>qwrtsdev</a
					>
				</p>
				<p class="text-center sm:text-right">
					กรุณาตรวจสอบข้อมูลก่อนสมัครเสมอเพื่อความถูกต้อง
				</p>
			</div>
		</footer>
	</body>
</html>

<script>
	if (import.meta.env.PROD && "serviceWorker" in navigator) {
		navigator.serviceWorker.register("/sw.js");
	}
</script>
