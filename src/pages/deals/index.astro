---
import Layout from "@/layouts/Layout.astro";
import DealCard from "@/components/DealCard.astro";
import { getCollection } from "astro:content";
import { categories, conditionals } from "@/lib/labels";
import { issueUrl } from "@/lib/links";
import { jsonScript } from "@/lib/format";
import { Search, SearchX } from "@lucide/astro";

const deals = (
	await getCollection("offers", ({ data }) => !data.archived)
).sort((a, b) =>
	a.data.provider.localeCompare(b.data.provider),
);
const usedCategories = [...new Set(deals.map((d) => d.data.category))];
const usedMethods = [
	...new Set(deals.map((d) => d.data.eligibility.method)),
];

const searchIndex = deals.map(({ id, data }) => ({
	id,
	name: data.name,
	provider: data.provider,
	summaryTh: data.summary.th,
	summaryEn: data.summary.en,
	category: categories[data.category],
	method: conditionals[data.eligibility.method],
}));

const chipClass =
	"shrink-0 rounded-full border border-line bg-surface px-4 py-1.5 text-sm font-medium text-muted transition hover:border-orange-400/70 hover:text-ink active:scale-95 aria-pressed:border-orange-400 aria-pressed:bg-orange-400 aria-pressed:text-neutral-950";
---

<Layout title="ดีลทั้งหมด">
	<main class="mx-auto max-w-6xl px-6 pb-20 pt-12">
		<h1 class="flex items-center gap-3 text-3xl font-black sm:text-4xl">
			ดีลทั้งหมด
			<span
				data-count
				class="rounded-xl bg-orange-400 px-2.5 py-0.5 text-lg font-bold tabular-nums text-neutral-950 sm:text-xl"
				>{deals.length}</span
			>
		</h1>

		<form
			action="/deals"
			method="get"
			role="search"
			data-deals-search
			class="mt-6 flex items-center gap-3 rounded-2xl border border-line bg-surface px-4 shadow-sm transition focus-within:border-orange-400 focus-within:ring-4 focus-within:ring-orange-400/15"
		>
			<label for="deals-q" class="sr-only">ค้นหาดีล</label>
			<Search size={20} stroke-width={2} class="shrink-0 text-faint" />
			<input
				id="deals-q"
				name="q"
				type="search"
				enterkeyhint="search"
				autocomplete="off"
				placeholder="ค้นหาชื่อแบรนด์ หรือแท็ก..."
				class="min-w-0 flex-1 bg-transparent py-3.5 text-base text-ink outline-none placeholder:text-faint"
			/>
		</form>

		<div
			class="mt-4 flex gap-2 overflow-x-auto pb-2 pr-10 [mask-image:linear-gradient(to_right,black_calc(100%_-_2.5rem),transparent)] [scrollbar-width:none]"
			role="group"
			aria-label="ตัวกรอง"
		>
			<button type="button" data-category="" class={chipClass}>
				ทั้งหมด
			</button>
			{
				usedCategories.map((c) => (
					<button type="button" data-category={c} class={chipClass}>
						{categories[c]}
					</button>
				))
			}
			<span aria-hidden="true" class="mx-1 my-1 w-px shrink-0 bg-line"></span>
			{
				usedMethods.map((m) => (
					<button type="button" data-method={m} class={chipClass}>
						{conditionals[m]}
					</button>
				))
			}
		</div>

		<ul data-deals class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				deals.map((deal) => (
					<li
						class="reveal"
						data-deal-id={deal.id}
						data-category={deal.data.category}
						data-method={deal.data.eligibility.method}
					>
						<DealCard deal={deal} />
					</li>
				))
			}
		</ul>

		<div
			data-empty
			hidden
			class="mt-6 flex flex-col items-center rounded-2xl border border-dashed border-line px-6 py-16 text-center"
		>
			<SearchX size={32} stroke-width={1.5} class="text-faint" />
			<p class="mt-3 font-semibold">ไม่พบดีลที่ตรงกับการค้นหา</p>
			<p class="mt-1 text-sm text-muted">
				ลองคำอื่น หรือ<a
					href={issueUrl}
					target="_blank"
					rel="noopener"
					class="font-medium text-orange-600 underline underline-offset-4 dark:text-orange-400"
					>เสนอดีลนี้ให้เรา</a
				>
			</p>
		</div>
	</main>

	<script
		type="application/json"
		id="deals-index"
		set:html={jsonScript(searchIndex)}
	/>
</Layout>

<script>
	import Fuse from "fuse.js";
	import {
		matchesFilters,
		readFilters,
		writeFilters,
	} from "@/lib/dealFilter";

	type Entry = { id: string };
	const index: Entry[] = JSON.parse(
		document.getElementById("deals-index")!.textContent!,
	);
	const fuse = new Fuse(index, {
		keys: [
			{ name: "provider", weight: 2 },
			{ name: "name", weight: 2 },
			"category",
			"method",
			"summaryTh",
			"summaryEn",
		],
		threshold: 0.35,
		ignoreLocation: true,
	});

	const form = document.querySelector<HTMLFormElement>(
		"[data-deals-search]",
	)!;
	const input = form.querySelector<HTMLInputElement>("input")!;
	const list = document.querySelector<HTMLUListElement>("[data-deals]")!;
	const items = [...list.querySelectorAll<HTMLLIElement>("[data-deal-id]")];
	const categoryChips = document.querySelectorAll<HTMLButtonElement>(
		"button[data-category]",
	);
	const methodChips =
		document.querySelectorAll<HTMLButtonElement>("button[data-method]");
	const count = document.querySelector("[data-count]")!;
	const empty = document.querySelector<HTMLElement>("[data-empty]")!;

	const filters = readFilters(new URLSearchParams(location.search));
	input.value = filters.q;

	function rankDeals(q: string) {
		const order = q
			? fuse.search(q).map((result) => result.item.id)
			: items.map((li) => li.dataset.dealId!);
		return new Map(order.map((id, i) => [id, i]));
	}

	function renderList(rank: Map<string, number>) {
		const position = (li: HTMLLIElement) => rank.get(li.dataset.dealId!)!;
		const shown = items.filter(
			(li) => rank.has(li.dataset.dealId!) && matchesFilters(li.dataset, filters),
		);
		items.forEach((li) => (li.hidden = !shown.includes(li)));
		list.append(...shown.sort((a, b) => position(a) - position(b)));
		return shown.length;
	}

	function renderCount(shown: number) {
		count.textContent = String(shown);
		empty.hidden = shown > 0;
	}

	function syncChips() {
		categoryChips.forEach((chip) =>
			chip.setAttribute(
				"aria-pressed",
				String(chip.dataset.category === filters.category),
			),
		);
		methodChips.forEach((chip) =>
			chip.setAttribute(
				"aria-pressed",
				String(chip.dataset.method === filters.method),
			),
		);
	}

	function apply() {
		filters.q = input.value.trim();
		renderCount(renderList(rankDeals(filters.q)));
		syncChips();
		history.replaceState(null, "", writeFilters(new URL(location.href), filters));
	}

	let chipTransition: ViewTransition | undefined;
	function applyAnimated() {
		if (
			!document.startViewTransition ||
			matchMedia("(prefers-reduced-motion: reduce)").matches
		)
			return apply();
		const name = (li: HTMLLIElement, on: boolean) =>
			(li.style.viewTransitionName = on ? `deal-${li.dataset.dealId}` : "");
		items.forEach((li) => name(li, true));
		const transition = (chipTransition = document.startViewTransition(apply));
		transition.finished.finally(() => {
			if (chipTransition === transition)
				items.forEach((li) => name(li, false));
		});
	}

	input.addEventListener("input", apply);
	form.addEventListener("submit", (event) => {
		event.preventDefault();
		apply();
	});
	categoryChips.forEach((chip) =>
		chip.addEventListener("click", () => {
			filters.category = chip.dataset.category ?? "";
			applyAnimated();
		}),
	);
	methodChips.forEach((chip) =>
		chip.addEventListener("click", () => {
			const method = chip.dataset.method!;
			filters.method = filters.method === method ? "" : method;
			applyAnimated();
		}),
	);
	apply();
</script>
