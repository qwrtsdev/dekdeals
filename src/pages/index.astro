										<!-- image -->
										dfkdf
									</p><p
										class="mt-2 text-sm leading-6 text-slate-600"
									>
										<!-- description -->
										fdfdfd
									</p>
								</div>
								<div class="rounded-2xl bg-slate-50 p-5">
									<p class="text-lg font-bold text-slate-950">
										<!-- image -->
										dfkdf
									</p><p
										class="mt-2 text-sm leading-6 text-slate-600"
									>
										<!-- description -->
										fdfdfd
									</p>
								</div>
								<div class="rounded-2xl bg-slate-50 p-5">
									<p class="text-lg font-bold text-slate-950">
										<!-- image -->
										dfkdf
									</p><p
										class="mt-2 text-sm leading-6 text-slate-600"
